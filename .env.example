# ============================================================
# RECARGAMUNDIAL - VARIABLES DE ENTORNO PARA PRODUCCIÓN & DESARROLLO
# ============================================================

# Puerto local del servidor (por defecto 3000)
PORT=3000

# URL pública de la aplicación en producción (usada para callbacks de pago y redirecciones)
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Inyectado automáticamente en AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ============================================================
# CREDENCIALES PARA RECARGAS MÓVILES REALES (RELOADLY AIRTIME)
# ============================================================
# 1. Regístrate en https://www.reloadly.com
# 2. Obtén tus credenciales en el Developer Dashboard
# 3. Recarga fondos en tu cuenta Reloadly para enviar saldo telefónico real
RELOADLY_CLIENT_ID=""
RELOADLY_CLIENT_SECRET=""

# Valores permitidos: 
# "sandbox" (pruebas gratuitas con números de prueba)
# "live" (¡SALDO TELEFÓNICO REAL entregado directamente a la SIM del usuario!)
RELOADLY_ENVIRONMENT="sandbox"

# ============================================================
# CREDENCIALES PARA COBROS REALES CON TARJETA & PAYPAL REST V2
# ============================================================
# 1. Crea tu app en https://developer.paypal.com/dashboard/applications
# 2. Copia tus Client ID y Secret Key (Modo Live para cobrar dinero real)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# Valores permitidos:
# "sandbox" (modo pruebas con cuentas ficticias de PayPal)
# "live" (cobros con dinero real depositados en tu cuenta bancaria / PayPal)
PAYPAL_ENVIRONMENT="sandbox"

# Enlace o usuario directo de PayPal.Me (usado como método alternativo o directo)
PAYPAL_ME_USERNAME="luis921904"
